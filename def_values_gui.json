{
  "window": {
    "title": "Fixed Grid Image Remapping",
    "geometry": "1280x760",
    "minsize": [
      900,
      600
    ]
  },
  "input": {
    "sample_pattern": "color_wheel",
    "width": 640,
    "height": 480
  },
  "transform": {
    "type": "barrel",
    "available_transforms": [
      "barrel",
      "pincushion",
      "swirl",
      "wave",
      "fisheye",
      "correction",
      "identity"
    ]
  },
  "grid": {
    "rows": 33,
    "cols": 33
  },
  "parameters": {
    "k1": {
      "value": 0.4,
      "range": [
        -1.0,
        1.0
      ],
      "resolution": 0.01
    },
    "strength": {
      "value": 2.5,
      "range": [
        0.1,
        5.0
      ],
      "resolution": 0.1
    },
    "amplitude": {
      "value": 15.0,
      "range": [
        1.0,
        60.0
      ],
      "resolution": 1.0
    }
  },
  "interpolation": {
    "pixel_interp": "cubic",
    "pixel_interp_options": [
      "nearest",
      "linear",
      "cubic",
      "lanczos"
    ],
    "grid_interp": "bicubic",
    "grid_interp_options": [
      "bicubic",
      "linear"
    ],
    "border_mode": "constant",
    "border_mode_options": [
      "constant",
      "replicate",
      "reflect",
      "wrap"
    ]
  },
  "display": {
    "show_grid_overlay": false,
    "grid_viz_type": "dots",
    "grid_viz_type_options": [
      "lines",
      "dots"
    ],
    "live_preview": true,
    "compute_heatmaps": true
  },
  "roi": {
    "draw": true,
    "crop": false,
    "x": 150,
    "y": 120,
    "w": 320,
    "h": 240
  },
  "flip_rotate": {
    "flip_h": true,
    "flip_v": true,
    "rotate": 0,
    "rotate_options": [
      0,
      90,
      180,
      270
    ]
  },
  "theme": {
    "name": "light",
    "background": "#f0f0f5",
    "background_secondary": "#e0e0e8",
    "background_input": "#d0d0db",
    "accent": "#4a4fd9",
    "accent_light": "#6a6ff0",
    "foreground": "#1a1a2e",
    "foreground_secondary": "#4a4a5e",
    "selection_background": "#4a4fd9",
    "selection_foreground": "#ffffff",
    "success_color": "#2d7a2d",
    "error_color": "#c93535",
    "warning_color": "#c97800"
  },
  "transform_params_map": {
    "barrel": [
      "k1"
    ],
    "pincushion": [
      "k1"
    ],
    "swirl": [
      "strength"
    ],
    "wave": [
      "amplitude"
    ],
    "fisheye": [],
    "correction": [
      "k1"
    ],
    "identity": []
  }
}